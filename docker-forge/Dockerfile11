FROM eclipse-temurin:11-jdk as build

RUN apt-get update -y && apt-get upgrade -y && apt-get install git wget -y \
    && git config --global core.autocrlf input

ARG version=1.12.2
ARG build=14.23.5.2859
ARG long_file=""

ENV version=$version
ENV build=$build
ENV long_file=$long_file

# curl https://files.minecraftforge.net/net/minecraftforge/forge/promotions_slim.json
# for version and builds

RUN wget "https://maven.minecraftforge.net/net/minecraftforge/forge/${version}-${build}${long_file}/forge-${version}-${build}${long_file}-installer.jar" -O "forge.jar" \
    && java -jar forge.jar --installServer \
    && rm forge.jar* \
    && if [ -e run.sh ]; then echo "using run.sh"; \
       elif [ -e forge*.jar ]; then mv forge*.jar forge.jar; \
       else echo "no forge"; fi

######################################################################################

FROM eclipse-temurin:11-jdk

RUN apt-get update -y && apt-get upgrade -y

RUN mkdir -p /data \
    && mkdir -p /mods

COPY --from=build /run.sh* /user_jvm_args.txt* /forge*.jar* /minecraft*.jar /opt/server/
COPY --from=build /libraries /opt/server/libraries

RUN adduser --disabled-password --gecos "" --home /home/minecraft minecraft \
    && chown -R minecraft /data /mods /home/minecraft \
    && chmod -R 755 /data /home/minecraft && chmod 1777 /data /mods \
    && [ -e /run.sh ] && chmod +x /run.sh || echo "no run.sh"

VOLUME ["/data","/mods"]

WORKDIR /data

USER minecraft

ARG flags=""
ARG start="-jar /data/forge.jar"

ENV min=1 \
    max=2 \
    JAVA_FLAGS="$flags" \
    SERVER_START="$start" \
    SERVER_ARGS="nogui"

COPY start.sh /start.sh

CMD ["/start.sh"]

EXPOSE 25565